{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Apex Setting Hub",
  "version": "1.0.0",
  "identifier": "com.apexsettinghub.desktop",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": { "windows": [{ "title": "Apex Setting Hub", "width": 1240, "height": 820, "minWidth": 950, "minHeight": 650 }], "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost; connect-src 'self' https://api.github.com" } },
  "bundle": { "active": true, "targets": ["nsis"], "icon": ["icons/icon.ico", "icons/icon.png"], "windows": { "nsis": { "installMode": "currentUser" } } }
}
